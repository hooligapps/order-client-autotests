{
  "name": "order-client-autotests",
  "version": "0.1.0",
  "private": true,
  "description": "E2E autotests for the WebGL order client",
  "scripts": {
    "test": "playwright test",
    "test:url": "node scripts/run-tests.mjs",
    "test:bootstrap": "playwright test --grep @bootstrap",
    "test:tutor": "playwright test --grep @tutor",
    "test:tutor:full": "playwright test --grep @full",
    "report": "playwright show-report",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm playwright",
    "docker:test:bootstrap": "docker compose run --rm bootstrap",
    "docker:test:tutor": "docker compose run --rm tutor",
    "docker:test:tutor:full": "docker compose run --rm tutor-full"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.8.3"
  }
}
